+++ b/codex-rs/linux-sandbox/src/landlock.rs
@@ -186,6 +186,18 @@ fn install_landlock_rules_on_current_thread(
 ///
 /// The filter is applied to the current thread so only the sandboxed child
 /// inherits it.
+#[cfg(all(target_arch = "x86", target_os = "linux", target_env = "musl"))]
+fn install_network_seccomp_filter_on_current_thread(
+    _mode: NetworkSeccompMode,
+) -> Result<()> {
+    // Fail closed if a caller tries to enable unavailable isolation.
+    // Ordinary CodexPad turns explicitly use the app-contained full-access
+    // guest profile; do not silently claim that a Linux sandbox was installed.
+    Err(codex_protocol::error::CodexErr::UnsupportedOperation(
+        "Linux network sandboxing is unavailable in iSH".to_string()))
+}
+
+#[cfg(not(all(target_arch = "x86", target_os = "linux", target_env = "musl")))]
 fn install_network_seccomp_filter_on_current_thread(
